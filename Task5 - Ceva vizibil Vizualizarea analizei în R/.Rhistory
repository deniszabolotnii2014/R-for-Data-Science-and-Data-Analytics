# 1. INTRODUCERE
# Scopul este transformarea perspectivelor analitice in
# vizualizari clare folosind ggplot2.
# 2. PACHETE
library(ggplot2)
library(dplyr)
library(readr)
# 3. INCARCAREA DATELOR
data_dir <- "."
genre_by_user <- read_csv(
file.path(data_dir, "RDSDA4_Task_05-genre_by_user.csv"),
show_col_types = FALSE
)
monthly_rentals <- read_csv(
file.path(data_dir, "RDSDA4_Task_05-monthly_rentals.csv"),
show_col_types = FALSE
)
ghost_users <- read_csv(
file.path(data_dir, "RDSDA4_Task_05-ghost_users.csv"),
show_col_types = FALSE
)
country_distribution <- read_csv(
file.path(data_dir, "RDSDA4_Task_05-country_distribution.csv"),
show_col_types = FALSE
)
# Verificari de baza cerute in tema
glimpse(genre_by_user)
summary(genre_by_user)
glimpse(monthly_rentals)
summary(monthly_rentals)
glimpse(ghost_users)
summary(ghost_users)
glimpse(country_distribution)
summary(country_distribution)
# Pregatire
genre_by_user <- genre_by_user %>%
mutate(
genre = if_else(is.na(genre) | genre == "", "Necunoscut", genre),
user_id = as.factor(user_id)
)
monthly_rentals <- monthly_rentals %>%
mutate(
month = as.integer(month),
month_name = factor(
month,
levels = 1:12,
labels = c(
"Ian", "Feb", "Mar", "Apr", "Mai", "Iun",
"Iul", "Aug", "Sep", "Oct", "Nov", "Dec"
)
)
)
ghost_users <- ghost_users %>%
mutate(rental_count = as.numeric(rental_count))
country_distribution <- country_distribution %>%
mutate(
country = if_else(is.na(country) | country == "", "Necunoscut", country)
)
# 4. VIZUALIZAREA 1
# Utilizator - gen - numar de imprumuturi
# Alegere: geom_col(), barplot.
# 'count' este deja calculat, deci geom_col() reprezinta direct
# valoarea. Umplerea pe gen permite sa vedem compozitia fiecarui
# utilizator.
p1 <- ggplot(
genre_by_user,
aes(x = user_id, y = count, fill = genre)
) +
geom_col(width = 0.75) +
labs(
title = "Numarul de imprumuturi pe utilizator si gen",
subtitle = "Compozitia imprumuturilor pentru fiecare utilizator",
x = "ID utilizator",
y = "Numar de imprumuturi",
fill = "Gen"
) +
theme_minimal(base_size = 12) +
theme(
axis.text.x = element_text(angle = 90, vjust = 0.5),
plot.title = element_text(face = "bold")
)
print(p1)
# 5. VIZUALIZAREA 2
# Evolutia lunara a numarului de imprumuturi
# Alegere: geom_line().
# Luna este o variabila temporala; linia face vizibile cresterile,
# scaderile si eventualele tipare sezoniere.
p2 <- ggplot(
monthly_rentals,
aes(x = month, y = rental_count, group = 1)
) +
geom_line(linewidth = 1) +
geom_point(size = 2.5) +
scale_x_continuous(
breaks = 1:12,
labels = levels(monthly_rentals$month_name)
) +
labs(
title = "Evolutia lunara a numarului de imprumuturi",
subtitle = "Numarul de imprumuturi inregistrate pe luni",
x = "Luna",
y = "Numar de imprumuturi"
) +
theme_minimal(base_size = 12) +
theme(plot.title = element_text(face = "bold"))
print(p2)
# 6. VIZUALIZAREA 3
# Utilizatori pe tari
# Alegere: geom_col() + coord_flip().
# Valorile user_count sunt deja agregate, iar barele permit o
# comparatie directa intre tari. Categoria Necunoscut este pastrata
# pentru transparenta asupra datelor lipsa.
p3 <- ggplot(
country_distribution,
aes(x = reorder(country, user_count), y = user_count)
) +
geom_col(width = 0.7) +
geom_text(
aes(label = user_count),
hjust = -0.15,
size = 4
) +
coord_flip() +
labs(
title = "Numarul de utilizatori pe tari",
subtitle = "Include si categoria pentru tara lipsa",
x = "Tara",
y = "Numar de utilizatori"
) +
expand_limits(y = max(country_distribution$user_count) * 1.12) +
theme_minimal(base_size = 12) +
theme(plot.title = element_text(face = "bold"))
print(p3)
# 7. VIZUALIZAREA 4
# Distributia numarului de imprumuturi per utilizator
# Alegere: geom_histogram().
# rental_count este numeric, iar histograma arata cati utilizatori
# se afla in fiecare interval al numarului de imprumuturi.
p4 <- ggplot(
ghost_users,
aes(x = rental_count)
) +
geom_histogram(
binwidth = 1,
boundary = 0.5,
closed = "right"
) +
labs(
title = "Distributia numarului de imprumuturi per utilizator",
subtitle = "Frecventa utilizatorilor in functie de imprumuturi",
x = "Numar de imprumuturi per utilizator",
y = "Numar de utilizatori"
) +
theme_minimal(base_size = 12) +
theme(plot.title = element_text(face = "bold"))
print(p4)
# 8. VIZUALIZAREA 5
# Genuri populare si pentru cine
# Alegere: geom_point() cu dimensiunea punctului = count.
# Nu folosim un scatterplot intre doua variabile numerice:
# aici punctele sunt folosite ca o matrice vizuala gen-utilizator.
# Pozitia arata cine si ce gen foloseste, iar marimea arata
# numarul de imprumuturi.
p5 <- ggplot(
genre_by_user,
aes(
x = genre,
y = user_id,
size = count
)
) +
geom_point(alpha = 0.8) +
scale_size_continuous(range = c(2.5, 10)) +
labs(
title = "Genurile populare si utilizatorii care le folosesc",
subtitle = "Marimea punctului indica numarul de imprumuturi",
x = "Gen",
y = "ID utilizator",
size = "Imprumuturi"
) +
theme_minimal(base_size = 12) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
plot.title = element_text(face = "bold")
)
print(p5)
# 9. CONCLUZIE
# Cele 5 grafice folosesc forme diferite in functie de intrebare:
# - geom_col(): comparatii intre categorii si valori agregate;
# - geom_line(): evolutie in timp;
# - geom_histogram(): distributia unei variabile numerice;
# - geom_point(): matrice vizuala utilizator-gen cu intensitatea
#   imprumuturilor exprimata prin marimea punctului.
